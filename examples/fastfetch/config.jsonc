// Fastfetch config generated at https://fastfetch.dev/#generator
// Save as ~/.config/fastfetch/config.jsonc
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small"
  },
  "display": {
    "separator": ": ",
    "color": {
      "keys": "blue"
    },
    "key": {
      "width": 12
    },
    "percent": {
      "type": 9
    }
  },
  "modules": [
    "title",
    "separator",
    "os",
    "packages",
    "shell",
    "display",
    "de",
    "wm",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    "disk",
    "break",
    "colors"
  ]
}

